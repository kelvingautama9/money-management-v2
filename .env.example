# GEMINI_API_KEY: Required for Gemini AI API calls.
# Mode 1 (AI Studio / Node Server): Injected automatically by AI Studio or set in .env.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Mode 2 (Web UI Manual Import):
# Users can directly input/import their Gemini API key from the Web UI modal.
# Stored securely in the user's browser localStorage.

# Mode 3 (Vercel Deployment):
# For Vercel Serverless Function & Edge:
# VERCEL_GEMINI_API_KEY="MY_GEMINI_API_KEY"
# For Client-Side Vite Fallback on Vercel:
# VITE_GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"
